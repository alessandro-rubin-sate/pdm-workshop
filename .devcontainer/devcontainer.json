{
    "name": "pdm-workshop",
    "image": "mcr.microsoft.com/devcontainers/python:3.13",
    "postCreateCommand": "pip install --quiet uv && uv sync && uv run scripts/demo.py",
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-python.python",
                "ms-python.debugpy",
                "ms-toolsai.jupyter",
                "charliermarsh.ruff"
            ],
            "settings": {
                "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python"
            }
        }
    }
}
